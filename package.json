{
  "name": "request-a-quote",
  "private": true,
  "scripts": {
    "build": "react-router build",
    "dev": "shopify app dev --config shopify.app.request-a-quote-dev.toml",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "echo 'Refusing a bare deploy: it targets whichever config is in use, which defaults to PROD. Run deploy:dev or deploy:prod.' && exit 1",
    "deploy:dev": "shopify app deploy --config shopify.app.request-a-quote-dev.toml",
    "deploy:prod": "shopify app deploy --config shopify.app.toml",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "react-router-serve ./build/server/index.js",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "shopify": "shopify",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@react-router/dev": "^7.17.0",
    "@react-router/fs-routes": "^7.17.0",
    "@react-router/node": "^7.17.0",
    "@react-router/serve": "^7.17.0",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^1.1.0",
    "@supabase/supabase-js": "^2.110.1",
    "@vercel/functions": "^3.7.5",
    "isbot": "^5.1.41",
    "posthog-node": "^5.48.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.17.0",
    "resend": "^6.18.1",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@shopify/api-codegen-preset": "^2.0.0",
    "@shopify/polaris-types": "1.0.7",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.9.2",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "graphql-config": "^5.1.1",
    "happy-dom": "^20.10.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^6.2.2",
    "vitest": "^4.1.8"
  },
  "workspaces": {
    "packages": [
      "extensions/*"
    ]
  },
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "overrides": {
    "p-map": "^4.0.0"
  }
}
